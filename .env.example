# -------------------------------------------------------
# Sudoku — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -------------------------------------------------------

# Server
PORT=8080

# IP on the internal hypervisor network that Traefik connects to.
# Set this to the IP of THIS VM on the private hypervisor network
# (e.g. 10.0.0.2) so port 8080 is not bound to the public interface.
# If your host firewall already blocks public access to 8080, you can
# leave this unset (defaults to 0.0.0.0).
INTERNAL_BIND_IP=10.0.0.2

# Public-facing base URL — must be HTTPS (Traefik terminates TLS)
BASE_URL=https://sudoku.example.com

# Redis password — must match what is passed to redis-server --requirepass
REDIS_PASSWORD=change-me-strong-password

# -------------------------------------------------------
# OIDC / Keycloak
# -------------------------------------------------------
#
# OIDC_ISSUER is used by the app to:
#   1. Fetch /.well-known/openid-configuration at startup
#   2. Validate the "iss" claim in every ID token
#
# The "iss" claim in Keycloak tokens equals Keycloak's own configured
# hostname URL — NOT necessarily the URL you use to reach it internally.
#
# Two common setups when Keycloak is also behind Traefik:
#
#   A) Use the public HTTPS URL (recommended):
#        OIDC_ISSUER=https://auth.example.com/realms/myrealm
#      The app container must be able to reach auth.example.com.
#      If DNS resolves auth.example.com to the Traefik VM's internal IP,
#      this works with no extra configuration.
#
#   B) Keycloak is reachable internally at http://keycloak-vm-ip:8080 but
#      its tokens say iss=https://auth.example.com/realms/myrealm.
#      go-oidc will REJECT the token — issuer mismatch.
#      Fix: configure Keycloak with KC_HOSTNAME=auth.example.com and
#      set OIDC_ISSUER to the public HTTPS URL (option A).
#
OIDC_ISSUER=https://auth.example.com/realms/myrealm
OIDC_CLIENT_ID=sudoku
OIDC_CLIENT_SECRET=your-keycloak-client-secret

# Must exactly match a Valid Redirect URI registered in Keycloak.
# Must be HTTPS.
OIDC_REDIRECT_URL=https://sudoku.example.com/callback

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-char-hex-secret

# Set to true to force re-generation of all 125 puzzles on next startup
PUZZLE_REGENERATE=false
